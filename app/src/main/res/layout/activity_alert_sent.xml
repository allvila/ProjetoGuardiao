<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D3D3D3"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- LOGO E TITULO -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="25dp"
            android:layout_marginBottom="15dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="20dp"
                android:orientation="vertical">
                <ImageView android:layout_width="100dp" android:layout_height="100dp" android:src="@android:drawable/ic_dialog_alert" app:tint="#B71C1C"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ALERTA ENVIADO" android:textColor="#1B5E20" android:textSize="26sp" android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- LOCALIZAÇÃO -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            android:layout_marginBottom="15dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="15dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🚨 EMERGÊNCIA REGISTRADA" android:textColor="#1B5E20" android:textStyle="bold" />
                <TextView android:id="@+id/txtEnderecoReal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="BUSCANDO LOCALIZAÇÃO..." android:textColor="#000" android:textSize="16sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- BOTÕES VERDES -->
        <Button
            android:id="@+id/btnVerMapa"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="VER LOCALIZAÇÃO NO MAPA"
            android:backgroundTint="#1B5E20"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"
            app:cornerRadius="20dp"/>

        <Button
            android:id="@+id/btnLigarEmergencia"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="LIGAR PARA EMERGÊNCIA"
            android:backgroundTint="#1B5E20"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="30dp"
            app:cornerRadius="20dp"/>

        <!-- CONFIGURAÇÕES (RODAPÉ) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnConfigRodape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FDE8E8"
            app:cardCornerRadius="15dp">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="15dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚙️ Configurações" android:textColor="#000" android:textStyle="bold" android:layout_centerVertical="true"/>
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_alignParentEnd="true" android:src="@android:drawable/ic_media_play" app:tint="#000"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>