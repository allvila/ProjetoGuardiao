<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="30dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cadastro iGuard"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#2C3E50"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configure o contato de emergência"
            android:textSize="14sp"
            android:textColor="#7F8C8D"
            android:layout_marginBottom="30dp"/>

        <!-- Dados do Idoso -->
        <EditText
            android:id="@+id/editNomeIdoso"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Nome do Idoso"
            android:background="@android:drawable/editbox_background"
            android:padding="12dp"
            android:layout_marginBottom="15dp"/>

        <!-- DADOS DO RESPONSÁVEL (O mais importante!) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contato do Responsável:"
            android:textStyle="bold"
            android:layout_marginBottom="5dp"/>

        <EditText
            android:id="@+id/editTelResponsavel"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="DDD + Número (Ex: 85999990000)"
            android:inputType="phone"
            android:background="@android:drawable/editbox_background"
            android:padding="12dp"
            android:layout_marginBottom="15dp"/>

        <EditText
            android:id="@+id/editEmailCad"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="E-mail de acesso"
            android:inputType="textEmailAddress"
            android:background="@android:drawable/editbox_background"
            android:padding="12dp"
            android:layout_marginBottom="15dp"/>

        <EditText
            android:id="@+id/editSenhaCad"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Crie uma Senha"
            android:inputType="textPassword"
            android:background="@android:drawable/editbox_background"
            android:padding="12dp"
            android:layout_marginBottom="25dp"/>

        <Button
            android:id="@+id/btnFinalizarCadastro"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="ATIVAR GUARDIÃO"
            android:backgroundTint="#27AE60"
            android:textColor="#FFFFFF"
            android:textStyle="bold"/>

    </LinearLayout>
</ScrollView>